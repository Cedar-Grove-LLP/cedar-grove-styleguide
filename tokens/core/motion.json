{
  "motion": {
    "duration": {
      "$description": "Interaction timing. Keep motion brief and purposeful — cedar-grove-styleguide/docs/foundations/elevation-and-motion.mdx explains when to use each step.",
      "fast": { "$value": "120ms", "$type": "duration" },
      "base": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "320ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "string" },
      "decelerate": { "$value": "cubic-bezier(0, 0, 0.2, 1)", "$type": "string" },
      "accelerate": { "$value": "cubic-bezier(0.4, 0, 1, 1)", "$type": "string" }
    }
  }
}
