{
  "palette": {
    "$description": "Raw color ramps. Named `palette.*` (not `color.*`) deliberately: it keeps the raw CSS variable (--palette-cedar-500) distinct from the Tailwind-facing theme key (--color-cedar-500) that globals.css maps it to, so @theme inline never has to reference a variable by its own name.",
    "cedar": {
      "$description": "Primary brand color. Deep forest/cedar green — used for primary actions, links, and brand moments.",
      "50": { "$value": "#f6f9f8", "$type": "color" },
      "100": { "$value": "#e8f2ee", "$type": "color" },
      "200": { "$value": "#cce6db", "$type": "color" },
      "300": { "$value": "#a4d6c2", "$type": "color" },
      "400": { "$value": "#75c7a6", "$type": "color" },
      "500": { "$value": "#49bc8e", "$type": "color" },
      "600": { "$value": "#389f75", "$type": "color" },
      "700": { "$value": "#2f7f5f", "$type": "color" },
      "800": { "$value": "#28624b", "$type": "color" },
      "900": { "$value": "#204637", "$type": "color" },
      "950": { "$value": "#142921", "$type": "color" }
    },
    "clay": {
      "$description": "Secondary accent. Warm copper/terracotta — used sparingly for highlights, illustration, and editorial accents. Never as the primary action color.",
      "50": { "$value": "#faf4ef", "$type": "color" },
      "100": { "$value": "#f6e5da", "$type": "color" },
      "200": { "$value": "#f0cbb2", "$type": "color" },
      "300": { "$value": "#eaaa80", "$type": "color" },
      "400": { "$value": "#e48a4e", "$type": "color" },
      "500": { "$value": "#db6d24", "$type": "color" },
      "600": { "$value": "#b45d22", "$type": "color" },
      "700": { "$value": "#914e22", "$type": "color" },
      "800": { "$value": "#6f3f1f", "$type": "color" },
      "900": { "$value": "#50301b", "$type": "color" },
      "950": { "$value": "#301e13", "$type": "color" }
    },
    "neutral": {
      "$description": "Warm-leaning gray scale (hue shifted toward cedar green rather than a cold blue-gray) used for text, surfaces, and borders.",
      "50": { "$value": "#fafafa", "$type": "color" },
      "100": { "$value": "#f5f5f4", "$type": "color" },
      "200": { "$value": "#e8e9e7", "$type": "color" },
      "300": { "$value": "#d4d6d1", "$type": "color" },
      "400": { "$value": "#adb2a9", "$type": "color" },
      "500": { "$value": "#878e80", "$type": "color" },
      "600": { "$value": "#666c60", "$type": "color" },
      "700": { "$value": "#4d5148", "$type": "color" },
      "800": { "$value": "#363932", "$type": "color" },
      "900": { "$value": "#242622", "$type": "color" },
      "950": { "$value": "#141613", "$type": "color" }
    }
  },
  "color": {
    "$description": "Status/utility colors, consumed only by alias (tokens/semantic/*.json) rather than exposed as direct utility classes — they never appear on the left-hand side of a @theme mapping, so no naming collision risk applies to this group.",
    "success": {
      "$description": "Status color: positive/complete states. Distinct hue from the cedar brand color so brand and status meaning never collide.",
      "100": { "$value": "#e7f8ed", "$type": "color" },
      "300": { "$value": "#a8e6bf", "$type": "color" },
      "500": { "$value": "#35b664", "$type": "color" },
      "600": { "$value": "#2b9752", "$type": "color" },
      "700": { "$value": "#207941", "$type": "color" },
      "900": { "$value": "#163b24", "$type": "color" }
    },
    "warning": {
      "$description": "Status color: caution/needs-attention states.",
      "100": { "$value": "#fef1d7", "$type": "color" },
      "300": { "$value": "#f8cd77", "$type": "color" },
      "500": { "$value": "#f1ae27", "$type": "color" },
      "600": { "$value": "#d89613", "$type": "color" },
      "700": { "$value": "#ae7b13", "$type": "color" },
      "900": { "$value": "#473615", "$type": "color" }
    },
    "danger": {
      "$description": "Status color: destructive/error states.",
      "100": { "$value": "#fde8e7", "$type": "color" },
      "300": { "$value": "#f49f9a", "$type": "color" },
      "500": { "$value": "#df423a", "$type": "color" },
      "600": { "$value": "#cc2c24", "$type": "color" },
      "700": { "$value": "#ab2821", "$type": "color" },
      "900": { "$value": "#4f1a17", "$type": "color" }
    },
    "info": {
      "$description": "Status color: neutral/informational states.",
      "100": { "$value": "#e8f2fc", "$type": "color" },
      "300": { "$value": "#9dc7f1", "$type": "color" },
      "500": { "$value": "#3585d4", "$type": "color" },
      "600": { "$value": "#2b70b6", "$type": "color" },
      "700": { "$value": "#255c93", "$type": "color" },
      "900": { "$value": "#172e45", "$type": "color" }
    },
    "white": { "$value": "#ffffff", "$type": "color" },
    "black": { "$value": "#000000", "$type": "color" }
  }
}
