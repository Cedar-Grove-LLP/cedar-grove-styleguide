{
  "$description": "Semantic (role) color tokens for the dark theme. Applied under a .dark class selector, overriding the :root light values one-for-one — same role names, so components never branch on theme.",
  "background": { "$value": "{palette.neutral.950}", "$type": "color" },
  "foreground": { "$value": "{palette.neutral.50}", "$type": "color" },
  "card": { "$value": "{palette.neutral.900}", "$type": "color" },
  "card-foreground": { "$value": "{palette.neutral.50}", "$type": "color" },
  "popover": { "$value": "{palette.neutral.900}", "$type": "color" },
  "popover-foreground": { "$value": "{palette.neutral.50}", "$type": "color" },
  "primary": { "$value": "{palette.cedar.400}", "$type": "color" },
  "primary-foreground": { "$value": "{palette.neutral.950}", "$type": "color" },
  "secondary": { "$value": "{palette.neutral.800}", "$type": "color" },
  "secondary-foreground": { "$value": "{palette.neutral.50}", "$type": "color" },
  "muted": { "$value": "{palette.neutral.800}", "$type": "color" },
  "muted-foreground": { "$value": "{palette.neutral.300}", "$type": "color" },
  "accent": { "$value": "{palette.clay.900}", "$type": "color" },
  "accent-foreground": { "$value": "{palette.clay.300}", "$type": "color" },
  "destructive": { "$value": "{color.danger.600}", "$type": "color" },
  "destructive-foreground": { "$value": "{color.white}", "$type": "color" },
  "success": { "$value": "{color.success.700}", "$type": "color" },
  "success-foreground": { "$value": "{color.white}", "$type": "color" },
  "warning": { "$value": "{color.warning.500}", "$type": "color" },
  "warning-foreground": { "$value": "{palette.neutral.950}", "$type": "color" },
  "info": { "$value": "{color.info.600}", "$type": "color" },
  "info-foreground": { "$value": "{color.white}", "$type": "color" },
  "border": { "$value": "{palette.neutral.800}", "$type": "color" },
  "input": { "$value": "{palette.neutral.800}", "$type": "color" },
  "ring": { "$value": "{palette.cedar.400}", "$type": "color" }
}
