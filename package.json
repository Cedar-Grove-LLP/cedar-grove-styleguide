{
  "name": "@cedar-grove/styleguide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cedar Grove LLP design system: design tokens, component primitives, and the written brand & content style guide.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run tokens:build && npm run typecheck && npm run lint && npm run test && npm run build-storybook",
    "tokens:build": "node style-dictionary.config.mjs",
    "tokens:watch": "node --watch style-dictionary.config.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "predev": "npm run tokens:build",
    "prebuild": "npm run tokens:build",
    "prestorybook": "npm run tokens:build",
    "prebuild-storybook": "npm run tokens:build"
  },
